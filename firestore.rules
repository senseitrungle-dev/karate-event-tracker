rules_version = '2';
// Karate Event Tracker v1.24.0 — Firestore security rules
// App admin            = roles/{uid}.role in ['admin','director']  (every event; approves tournament directors)
// Tournament director  = roles/{uid}.role == 'organizer'           (may create events)
// Event director       = uid in events/{e}.directorIds              (full control of that event only)
// Ring manager         = uid in events/{e}/rings/{r}.managerIds     (scores that ring; listed in events/{e}.managerIds)
// Everyone signed in sees the event list (name, dates); only an event's directors / ring managers / staff (and app
// admins) read its data — or anyone while the event is live and public. Private competitor data (pv/) is director-only.
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    // v1.21: someone whose access the app admin removed is treated as signed out until restored
    function blocked() { return exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function signedIn() { return authed() && !blocked(); }
    function roleDoc() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function myRole() { return signedIn() && exists(roleDoc()) ? get(roleDoc()).data.role : ''; }
    function isAdmin() { return myRole() in ['admin', 'director']; }
    function isOrganizer() { return isAdmin() || myRole() == 'organizer'; }
    function ev(e) { return get(/databases/$(database)/documents/events/$(e)).data; }
    function evDirector(e) { return isAdmin() || (signedIn() && request.auth.uid in ev(e).get('directorIds', [])); }
    function evMember(e) {
      return evDirector(e) || (signedIn() && (request.auth.uid in ev(e).get('managerIds', []) || request.auth.uid in ev(e).get('staffIds', [])));
    }
    // approved & archived events are read-only (only the event document itself can be changed, to reopen it)
    function open_(e) { return ev(e).get('locked', false) != true; }
    function isPublic(e) { return ev(e).get('public', false) == true; }
    function ring(e, rid) { return get(/databases/$(database)/documents/events/$(e)/rings/$(rid)).data; }
    function managesRing(e, rid) { return signedIn() && rid is string && rid != '' && request.auth.uid in ring(e, rid).get('managerIds', []); }
    function managesDiv(e, did) {
      let d = get(/databases/$(database)/documents/events/$(e)/divisions/$(did)).data;
      return managesRing(e, d.get('ringId', '')) || (signedIn() && request.auth.uid in d.get('scorerIds', []));
    }
    function isStaff(e) { return signedIn() && request.auth.uid in ev(e).get('staffIds', []); }
    // invitations: invites/{email}; the invited person applies their own invite on first sign-in
    // v1.22: only a confirmed address counts (Google accounts always are; email + password accounts after the email link)
    function claimDoc() { return /databases/$(database)/documents/claims/$(request.auth.uid); }
    // v1.24: an email+password account made with an invitation code proves its address through claims/{uid}
    function claimed() { return exists(claimDoc()) && get(claimDoc()).data.email == request.auth.token.email.lower(); }
    function myEmail() { return signedIn() && request.auth.token.email != null && (request.auth.token.email_verified == true || claimed()) ? request.auth.token.email.lower() : ''; }
    function myInvite() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function invitedAs(role) { return myEmail() != '' && exists(myInvite()) && get(myInvite()).data.role == role; }
    function addsOnlyMe(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field].hasAll(resource.data.get(field, []))
        && request.resource.data[field].size() == resource.data.get(field, []).size() + 1
        && request.auth.uid in request.resource.data[field];
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /roles/{uid} {
      allow read: if signedIn();
      // the first person claims app admin together with meta/bootstrap (one batch); afterwards only app admins
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'director'
        && !exists(/databases/$(database)/documents/meta/bootstrap)
        && existsAfter(/databases/$(database)/documents/meta/bootstrap))
        // v1.20: someone the app admin invited as a tournament director accepts their own invitation
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'organizer' && myEmail() != ''
            && exists(myInvite()) && get(myInvite()).data.get('scope', '') == 'app' && get(myInvite()).data.role == 'organizer');
      allow update, delete: if isAdmin() && uid != request.auth.uid;
    }
    match /meta/branding {          // app logo choice (v1.12)
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && getAfter(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'director';
    }
    // "I'd like to run my own tournament" — each person writes only their own request; app admins decide
    match /orgRequests/{uid} {
      allow create: if authed() && request.auth.uid == uid;          // also "let me back in" after access was removed
      allow read, delete: if isAdmin() || (authed() && request.auth.uid == uid);
    }
    match /blocked/{uid} {                                           // v1.21: access removed by the app admin
      allow read: if isAdmin() || (authed() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    match /meta/access {                                             // v1.21: app-level roster (managers / not assigned)
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /invites/{email} {
      allow read: if isAdmin() || (myEmail() != '' && myEmail() == email) || (signedIn() && resource.data.get('by', '') == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || (request.resource.data.get('scope', '') != 'app' && evDirector(request.resource.data.eventId)));   // v1.20: app-level invites by app admins
      allow delete: if isAdmin() || (myEmail() != '' && myEmail() == email) || (signedIn() && resource.data.get('by', '') == request.auth.uid)
        || (signedIn() && resource.data.get('eventId', '') != '' && evDirector(resource.data.eventId));   // v1.14: any director of that event
    }
    // v1.24: invitation codes — only SHA-256(email:code) is stored; anyone may test a hash, nobody can list them
    match /invcodes/{h} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.email is string
        && (isAdmin() || (request.resource.data.get('eventId', '') != '' && evDirector(request.resource.data.eventId)));
      allow delete: if isAdmin() || (signedIn() && resource.data.get('by', '') == request.auth.uid)
        || (myEmail() != '' && myEmail() == resource.data.email)
        || (signedIn() && resource.data.get('eventId', '') != '' && evDirector(resource.data.eventId));
    }
    // the new account records which invitation code it used (its own email + an existing code hash)
    match /claims/{uid} {
      allow get: if isAdmin() || (authed() && request.auth.uid == uid);
      allow create: if authed() && request.auth.uid == uid && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email.lower()
        && exists(/databases/$(database)/documents/invcodes/$(request.resource.data.h))
        && get(/databases/$(database)/documents/invcodes/$(request.resource.data.h)).data.email == request.resource.data.email;
      allow update, delete: if isAdmin();
    }
    match /share/{token} {
      allow get: if true;          // a link holder can resolve their own token…
      allow list: if false;        // …but nobody can enumerate shared events
      allow create: if signedIn() && evDirector(request.resource.data.eventId);
      allow delete: if signedIn() && evDirector(resource.data.eventId);
    }
    match /events/{e} {
      allow get: if signedIn() || resource.data.get('public', false) == true;
      allow list: if signedIn();   // name and dates of every event; the event list is never public
      allow create: if isOrganizer() && request.auth.uid in request.resource.data.get('directorIds', []);
      allow update: if evDirector(e)
        || (invitedAs('director') && get(myInvite()).data.eventId == e && addsOnlyMe('directorIds'))
        || (invitedAs('manager') && get(myInvite()).data.eventId == e && addsOnlyMe('managerIds'));
      allow delete: if evDirector(e);
      match /{sub=**} {
        allow read: if evMember(e) || isPublic(e);
        allow write: if evDirector(e) && open_(e);
      }
      // an invited ring manager adds only themself to the ring named in their invite
      match /rings/{r} {
        allow update: if open_(e) && invitedAs('manager') && get(myInvite()).data.eventId == e && get(myInvite()).data.ringId == r && addsOnlyMe('managerIds');
      }
      // access requests: anyone signed in asks for themself; the event's directors approve or decline
      match /requests/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read, delete: if evDirector(e) || (signedIn() && request.auth.uid == uid);
      }
    }
    match /pv/{e}/{rest=**} {
      allow read: if evDirector(e);
      allow write: if evDirector(e) && open_(e);
    }
    match /live/{e}/brackets/{did} {
      allow read: if evMember(e) || isPublic(e);
      allow create, delete: if evDirector(e) && open_(e);
      allow update: if open_(e) && (evDirector(e) || managesDiv(e, did));
    }
    match /live/{e}/ringstate/{rid} {
      allow read: if evMember(e) || isPublic(e);
      allow write: if open_(e) && (evDirector(e) || managesRing(e, rid));
    }
    match /live/{e}/ringready/{rid} {
      allow read: if evMember(e) || isPublic(e);
      allow write: if open_(e) && (evDirector(e) || managesRing(e, rid));
    }
    match /live/{e}/attendance/{sid} {
      allow read: if evMember(e) || isPublic(e);
      allow write: if open_(e) && (evDirector(e) || isStaff(e));
    }
  }
}
