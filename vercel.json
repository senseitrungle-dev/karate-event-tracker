{
  "buildCommand": "",
  "outputDirectory": "vercel",
  "cleanUrls": true,
  "functions": { "api/live.js": { "includeFiles": "vercel/firebase-config.js", "maxDuration": 10 } },
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }]
}
